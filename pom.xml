<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.bitdreamit.mirth.labextensions.serialconnector</groupId>
    <artifactId>bitdreamit-serial-connector</artifactId>
    <version>1.3.0</version>
    <packaging>pom</packaging>

    <name>bitdreamit-serial-connector</name>
    <description>Serial Connector plugin for Mirth Connect 4.5+ — RS-232/RS-485 source and destination</description>
    <url>https://bitdreamit.com</url>
    <inceptionYear>2025</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mirth.libs>${user.home}/mirth-libs</mirth.libs>
        <mirth.version>4.5.2</mirth.version>
        <miglayout.version>4.2</miglayout.version>
        <log4j12api.version>2.17.2</log4j12api.version>
        <jserialcomm.version>2.10.4</jserialcomm.version>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
    </properties>

    <modules>
        <module>shared</module>
        <module>server</module>
        <module>client</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.bitdreamit.mirth.labextensions.serialconnector</groupId>
                <artifactId>bitdreamit-serial-connector-shared</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.mirth</groupId>
                <artifactId>mirth-client-core</artifactId>
                <version>${mirth.version}</version>
                <scope>system</scope>
                <systemPath>${mirth.libs}/client/mirth-client-core.jar</systemPath>
            </dependency>
            <dependency>
                <groupId>com.mirth</groupId>
                <artifactId>mirth-client</artifactId>
                <version>${mirth.version}</version>
                <scope>system</scope>
                <systemPath>${mirth.libs}/client/mirth-client.jar</systemPath>
            </dependency>
            <dependency>
                <groupId>com.mirth</groupId>
                <artifactId>mirth-server</artifactId>
                <version>${mirth.version}</version>
                <scope>system</scope>
                <systemPath>${mirth.libs}/server/mirth-server.jar</systemPath>
            </dependency>
            <dependency>
                <groupId>com.mirth</groupId>
                <artifactId>donkey-server</artifactId>
                <version>${mirth.version}</version>
                <scope>system</scope>
                <systemPath>${mirth.libs}/server/donkey-server.jar</systemPath>
            </dependency>
            <dependency>
                <groupId>com.miglayout</groupId>
                <artifactId>miglayout-core</artifactId>
                <version>${miglayout.version}</version>
                <scope>system</scope>
                <systemPath>${mirth.libs}/client/miglayout-core-${miglayout.version}.jar</systemPath>
            </dependency>
            <dependency>
                <groupId>com.miglayout</groupId>
                <artifactId>miglayout-swing</artifactId>
                <version>${miglayout.version}</version>
                <scope>system</scope>
                <systemPath>${mirth.libs}/client/miglayout-swing-${miglayout.version}.jar</systemPath>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-1.2-api</artifactId>
                <version>${log4j12api.version}</version>
                <scope>system</scope>
                <systemPath>${mirth.libs}/server/log4j-1.2-api-${log4j12api.version}.jar</systemPath>
            </dependency>
            <dependency>
                <groupId>com.fazecast</groupId>
                <artifactId>jSerialComm</artifactId>
                <version>${jserialcomm.version}</version>
                <scope>system</scope>
                <systemPath>${project.basedir}/../lib/jSerialComm-${jserialcomm.version}.jar</systemPath>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <source>${maven.compiler.source}</source>
                        <target>${maven.compiler.target}</target>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.3.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
